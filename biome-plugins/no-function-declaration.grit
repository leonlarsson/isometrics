// Enforces arrow functions: `const name = (...) => { ... }` instead of
// `function name(...) { ... }`.
// Exception: TanStack route files (src/routes/**), where `export const Route`
// comes first and the hoisted component function follows it.
// See docs/adr/0015-arrow-functions-and-named-exports.md.
language js

JsFunctionDeclaration(id = $name) where {
	$filename <: not includes "src/routes/",
	register_diagnostic(
		span = $name,
		message = "Use an arrow function (`const name = (...) => {}`) instead of a function declaration."
	)
}
