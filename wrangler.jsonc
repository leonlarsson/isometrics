{
  "$schema": "node_modules/wrangler/config-schema.json",
  
  "name": "isometrics",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",

  "observability": {
    "enabled": true
  },

  // Worlds people share by link (ADR-0120): one snapshot per key, deleted by KV when it expires.
  // Prefabs people share by link (ADR-0134), the same way: the Isometrics User Prefabs namespace.
  "kv_namespaces": [
    { "binding": "USER_WORLDS", "id": "a74a79e512924e1d8f78cc010d5b7426" },
    { "binding": "USER_PREFABS", "id": "6f1ee6e868f74e6eb799f06ea97d9515" }
  ],

  // At most 10 shared worlds, and 10 shared prefabs, a minute from one address, so the stores can't
  // be flooded.
  "ratelimits": [
    { "name": "USER_WORLD_UPLOADS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "USER_PREFAB_UPLOADS", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],

  // Pull requests get a preview build (wrangler preview). Its plain settings follow the top level, but
  // bindings aren't inherited: each is listed here too (the same KV namespace as production for now).
  "previews": {
    "kv_namespaces": [
      { "binding": "USER_WORLDS", "id": "a74a79e512924e1d8f78cc010d5b7426" },
      { "binding": "USER_PREFABS", "id": "6f1ee6e868f74e6eb799f06ea97d9515" }
    ],
    "ratelimits": [
      { "name": "USER_WORLD_UPLOADS", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
      { "name": "USER_PREFAB_UPLOADS", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
    ]
  }
}
